diff --git a/transport/internet/connection_reset.go b/transport/internet/connection_reset.go
new file mode 100644
index 0000000..6698369
--- /dev/null
+++ b/transport/internet/connection_reset.go
@@ -0,0 +1,183 @@
+package internet
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+const (
+	connectionPruneInterval = 5 * time.Second
+	connectionPruneIdle     = 2 * time.Minute
+)
+
+type trackedConn interface {
+	Close() error
+}
+
+type syscallConnection interface {
+	SyscallConn() (syscall.RawConn, error)
+}
+
+// connectionResetController keeps the system connections opened by one Xray
+// instance. It is deliberately attached to the instance context so resetting
+// a temporary delay-test instance cannot interrupt the running core.
+type connectionResetController struct {
+	enabled atomic.Bool
+	ctx     context.Context
+	lastDial atomic.Int64
+
+	mu      sync.Mutex
+	conns   map[uint64]trackedConn
+	nextKey uint64
+	reaping bool
+}
+
+type connectionResetContextKey struct{}
+
+// WithConnectionReset creates an instance-scoped connection reset controller
+// in ctx. Xray instances call this once while they are being constructed.
+func WithConnectionReset(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	controller := &connectionResetController{
+		ctx:    ctx,
+		conns:  make(map[uint64]trackedConn),
+	}
+	controller.enabled.Store(true)
+	return context.WithValue(ctx, connectionResetContextKey{}, controller)
+}
+
+func connectionResetFromContext(ctx context.Context) *connectionResetController {
+	if ctx == nil {
+		return nil
+	}
+	controller, _ := ctx.Value(connectionResetContextKey{}).(*connectionResetController)
+	return controller
+}
+
+// InheritConnectionReset copies the instance controller from parent to ctx.
+// Xray creates request contexts from context.Background in a few public APIs;
+// inheriting here keeps those requests associated with the owning instance.
+func InheritConnectionReset(ctx context.Context, parent context.Context) context.Context {
+	if controller := connectionResetFromContext(parent); controller != nil {
+		return context.WithValue(ctx, connectionResetContextKey{}, controller)
+	}
+	return ctx
+}
+
+// SetConnectionResetEnabled controls whether ResetConnections closes tracked
+// connections. Connections remain tracked while disabled so enabling the
+// switch takes effect on the next reset without losing the current sockets.
+func SetConnectionResetEnabled(ctx context.Context, enabled bool) {
+	if controller := connectionResetFromContext(ctx); controller != nil {
+		controller.enabled.Store(enabled)
+	}
+}
+
+// ResetConnections closes all system connections opened by the instance
+// represented by ctx. Closing the raw transport connection also tears down
+// protocol wrappers such as TLS, HTTP/2 and QUIC.
+func ResetConnections(ctx context.Context) {
+	controller := connectionResetFromContext(ctx)
+	if controller == nil || !controller.enabled.Load() {
+		return
+	}
+	controller.reset()
+}
+
+func (c *connectionResetController) reset() {
+	c.mu.Lock()
+	conns := c.conns
+	c.conns = make(map[uint64]trackedConn, len(conns))
+	c.mu.Unlock()
+
+	for _, conn := range conns {
+		_ = conn.Close()
+	}
+}
+
+func (c *connectionResetController) track(conn trackedConn) {
+	c.lastDial.Store(time.Now().UnixNano())
+
+	c.mu.Lock()
+	c.nextKey++
+	c.conns[c.nextKey] = conn
+	startReaper := !c.reaping
+	if startReaper {
+		c.reaping = true
+	}
+	c.mu.Unlock()
+
+	if startReaper {
+		go c.reapLoop()
+	}
+}
+
+func (c *connectionResetController) reapLoop() {
+	ticker := time.NewTicker(connectionPruneInterval)
+	defer ticker.Stop()
+
+	var done <-chan struct{}
+	if c.ctx != nil {
+		done = c.ctx.Done()
+	}
+
+	for {
+		select {
+		case <-done:
+			c.mu.Lock()
+			c.reaping = false
+			c.mu.Unlock()
+			return
+		case <-ticker.C:
+			idleSince := time.Since(time.Unix(0, c.lastDial.Load()))
+			c.mu.Lock()
+			c.reapLocked()
+			if len(c.conns) == 0 && idleSince > connectionPruneIdle {
+				c.reaping = false
+				c.mu.Unlock()
+				return
+			}
+			c.mu.Unlock()
+		}
+	}
+}
+
+func (c *connectionResetController) reapLocked() {
+	for key, conn := range c.conns {
+		sc, ok := conn.(syscallConnection)
+		if !ok {
+			continue
+		}
+		raw, err := sc.SyscallConn()
+		if err != nil {
+			delete(c.conns, key)
+			continue
+		}
+		if err := raw.Control(func(uintptr) {}); err != nil {
+			delete(c.conns, key)
+		}
+	}
+}
+
+func trackConnection(ctx context.Context, conn trackedConn) {
+	if controller := connectionResetFromContext(ctx); controller != nil && conn != nil {
+		controller.track(conn)
+	}
+}
+
+func trackDialedConnection(ctx context.Context, conn net.Conn) net.Conn {
+	trackConnection(ctx, conn)
+	return conn
+}
+
+func trackDialedPacketConn(ctx context.Context, conn net.PacketConn) net.PacketConn {
+	trackConnection(ctx, conn)
+	return conn
+}
