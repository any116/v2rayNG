 }
 
 // CoreCallbackHandler defines interface for receiving callbacks and notifications from the core service
@@ -99,7 +104,34 @@ func NewCoreController(s CoreCallbackHandler) *CoreController {
 	}
 
 	return &CoreController{
-		CallbackHandler: s,
+		CallbackHandler:         s,
+		connectionResetEnabled: true,
+	}
+}
+
+// SetConnectionResetEnabled enables or disables closing tracked outbound
+// connections during an explicit reset or core shutdown. The default is true
+// so network handovers and normal shutdown do not retain stale sockets.
+func (x *CoreController) SetConnectionResetEnabled(enabled bool) {
+	x.coreMutex.Lock()
+	x.connectionResetEnabled = enabled
+	instance := x.coreInstance
+	x.coreMutex.Unlock()
+
+	if instance != nil {
+		instance.SetConnectionResetEnabled(enabled)
+	}
+}
+
+// ResetConnections closes all tracked outbound connections for this core when
+// connection reset is enabled. It is safe to call while the core is running.
+func (x *CoreController) ResetConnections() {
+	x.coreMutex.Lock()
+	instance := x.coreInstance
+	x.coreMutex.Unlock()
+
+	if instance != nil {
+		instance.ResetConnections()
 	}
 }
 
@@ -118,7 +150,15 @@ func (x *CoreController) StartLoop(configContent string, tunFd int32) (err error
 		return nil
 	}
 
-	return x.doStartLoop(configContent)
+	ctx, cancel := context.WithCancel(context.Background())
+	x.ctx, x.cancel = ctx, cancel
+	if err := x.doStartLoop(configContent); err != nil {
+		cancel()
+		x.doShutdown()
+		x.ctx, x.cancel = nil, nil
+		return err
+	}
+	return nil
 }
 
 // StopLoop safely stops the core processing loop and releases resources
@@ -128,6 +168,12 @@ func (x *CoreController) StopLoop() error {
 	defer x.coreMutex.Unlock()
 
 	if x.IsRunning {
+		if x.cancel != nil {
+			x.cancel()
+		}
+		if x.coreInstance != nil {
+			x.coreInstance.ResetConnections()
+		}
 		x.doShutdown()
 		x.CallbackHandler.Shutdown()
 		x.CallbackHandler.OnEmitStatus(0, "Core stopped")
@@ -157,6 +203,8 @@ func (x *CoreController) doShutdown() {
 	}
 	x.IsRunning = false
 	x.statsManager = nil
+	x.ctx = nil
+	x.cancel = nil
 }
 
