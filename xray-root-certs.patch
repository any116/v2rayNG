diff --git a/app/dns/root_certs_test.go b/app/dns/root_certs_test.go
new file mode 100644
index 0000000..2e565a99
--- /dev/null
+++ b/app/dns/root_certs_test.go
@@ -0,0 +1,49 @@
+package dns
+
+import (
+	"net/url"
+	"testing"
+)
+
+func TestLoadRootCertPoolRemovesPrivateQueryOnReadError(t *testing.T) {
+	u, err := url.Parse("dot+local://dns.example:853?keep=1&xrayRootCertFile=/missing/root.pem")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err = loadRootCertPoolFromURL(u); err == nil {
+		t.Fatal("expected missing root certificate file to fail")
+	}
+	if got := u.Query().Get(rootCertFileQuery); got != "" {
+		t.Fatalf("private root certificate query remains: %q", got)
+	}
+	if got := u.Query().Get("keep"); got != "1" {
+		t.Fatalf("unrelated query parameter changed: %q", got)
+	}
+}
+
+func TestDoTLocalNameServerRejectsUnreadableRootFile(t *testing.T) {
+	u, err := url.Parse("dot+local://dns.example:853?xrayRootCertFile=/missing/root.pem")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err = NewDoTLocalNameServer(u, false, false, 0, nil); err == nil {
+		t.Fatal("expected DoT constructor to reject an unreadable root certificate file")
+	}
+}
+
+func TestDoTLocalNameServerDefaultsToPort853(t *testing.T) {
+	u, err := url.Parse("dot+local://dns.example")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	s, err := NewDoTLocalNameServer(u, false, false, 0, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := s.Name(); got != "DOTL//dns.example:853" {
+		t.Fatalf("unexpected DoT destination: %q", got)
+	}
+}
