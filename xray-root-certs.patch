+// NewDoTNameServer creates a DNS-over-TLS server object for remote resolving.
+// The connection is dispatched through Xray before the TLS handshake.
+func NewDoTNameServer(
+	url *url.URL,
+	dispatcher routing.Dispatcher,
+	disableCache bool, serveStale bool, serveExpiredTTL uint32,
+	clientIP net.IP,
+) (*TCPNameServer, error) {
+	return newDoTNameServer(url, dispatcher, disableCache, serveStale, serveExpiredTTL, clientIP, "DOT")
+}
+
+// NewDoTLocalNameServer creates a DNS-over-TLS server object for local resolving.
+func NewDoTLocalNameServer(url *url.URL, disableCache bool, serveStale bool, serveExpiredTTL uint32, clientIP net.IP) (*TCPNameServer, error) {
+	return newDoTNameServer(url, nil, disableCache, serveStale, serveExpiredTTL, clientIP, "DOTL")
+}
+
+func newDoTNameServer(
+	url *url.URL,
+	dispatcher routing.Dispatcher,
+	disableCache bool, serveStale bool, serveExpiredTTL uint32,
+	clientIP net.IP,
+	prefix string,
+) (*TCPNameServer, error) {
+	rootCAs, err := loadRootCertPoolFromURL(url)
+	if err != nil {
+		return nil, err
+	}
+	s, err := baseTCPNameServerWithPort(url, prefix, net.Port(853), disableCache, serveStale, serveExpiredTTL, clientIP)
+	if err != nil {
+		return nil, err
+	}
+	s.tlsConfig = &gotls.Config{
+		MinVersion: gotls.VersionTLS12,
+		RootCAs:    rootCAs,
+		ServerName: url.Hostname(),
+	}
+	if dispatcher == nil {
+		s.dial = func(ctx context.Context) (net.Conn, error) {
+			return internet.DialSystem(ctx, *s.destination, nil)
+		}
+	} else {
+		s.dial = func(ctx context.Context) (net.Conn, error) {
+			link, err := dispatcher.Dispatch(toDnsContext(ctx, s.destination.String()), *s.destination)
+			if err != nil {
+				return nil, err
+			}
+
+			return cnc.NewConnection(
+				cnc.ConnectionInputMulti(link.Writer),
+				cnc.ConnectionOutputMulti(link.Reader),
+			), nil
+		}
+	}
+
+	errors.LogInfo(context.Background(), "DNS: created ", prefix, " client initialized for ", url.String())
+	return s, nil
+}
