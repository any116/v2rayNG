+func (s *TCPNameServer) secure(ctx context.Context, conn net.Conn) (net.Conn, error) {
+	if s.tlsConfig == nil {
+		return conn, nil
+	}
+	tlsConn := gotls.Client(conn, s.tlsConfig.Clone())
+	if err := tlsConn.HandshakeContext(ctx); err != nil {
+		_ = conn.Close()
+		return nil, err
+	}
+	return tlsConn, nil
+}
