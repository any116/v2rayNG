new file mode 100644
index 0000000..292e4347
--- /dev/null
+++ b/app/dns/root_certs.go
@@ -0,0 +1,38 @@
+package dns
+
+import (
+	"crypto/x509"
+	"fmt"
+	"net/url"
+	"os"
+	"strings"
+)
+
+const rootCertFileQuery = "xrayRootCertFile"
+
+// loadRootCertPoolFromURL consumes the app-private CA bundle query parameter.
+// The parameter is removed from the URL before the URL is used for an HTTP request,
+// so the local file path is never sent to the DNS provider.
+func loadRootCertPoolFromURL(u *url.URL) (*x509.CertPool, error) {
+	if u == nil {
+		return nil, nil
+	}
+
+	query := u.Query()
+	path := strings.TrimSpace(query.Get(rootCertFileQuery))
+	if path == "" {
+		return nil, nil
+	}
+	query.Del(rootCertFileQuery)
+	u.RawQuery = query.Encode()
+
+	pemBytes, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read root certificate file %q: %w", path, err)
+	}
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(pemBytes) {
+		return nil, fmt.Errorf("parse root certificate file %q", path)
+	}
+	return pool, nil
+}
